PREFIX : <https://linked.data.gov.au/def/valpub/>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX prof: <http://www.w3.org/ns/dx/prof/>
PREFIX role: <http://www.w3.org/ns/dx/prof/role/>
PREFIX sdo: <https://schema.org/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

<https://orcid.org/0000-0002-8742-7730>
    a sdo:Person ;
    sdo:email "nicholas.car@anu.edu.au"^^xsd:anyURI ;
    sdo:identifier "https://orcid.org/0000-0002-8742-7730"^^xsd:anyURI ;
    sdo:memberOf <https://linked.data.gov.au/org/agldwg> ;
    sdo:name "Nicholas J. Car" ;
.

<https://linked.data.gov.au/def/valpub>
    a prof:Profile ;
    skos:definition """This is a profile of the OWL, RDFS, schema.org, SKOS and SHACL ontologies used to define and annotate collections of SHACL Shapes presented in ontologies. It supplies requirements, defines testable rules and some other supporting resources for its use.

This profile is formulated according to the Profiles Vocabulary"""@en ;
    skos:prefLabel "ValPub Profile"@en ;
    prof:hasResource
        :htv ,
        :repo ,
        :spec ,
        :validator ;
    prof:isProfileOf
        <http://www.w3.org/TR/owl-rdf-based-semantics> ,
        <https://schema.org> ,
        <https://www.w3.org/TR/rdf-schema/> ,
        <https://www.w3.org/TR/skos-reference/> ,
        <https://www.w3.org/TR/shacl12-core/> ;
    sdo:creator <https://orcid.org/0000-0002-8742-7730> ;
    sdo:dateCreated "2026-01-15"^^xsd:date ;
    sdo:dateModified "2026-11-06"^^xsd:date ;
    sdo:publisher <https://linked.data.gov.au/org/agldwg> ;
.

:repo
    prof:hasArtifact "https://github.com/AGLDWG/valpub-profile"^^xsd:anyURI ;
    prof:hasRole role:repository ;
    sdo:description "Code repository storing all Profile artifacts"@en ;
    sdo:name "Profile code repository"@en ;
.

:spec
    dcterms:conformsTo <https://www.w3.org/TR/html52/> ;
    dcterms:format "text/html" ;
    prof:hasArtifact "https://linked.data.gov.au/def/valpub/spec"^^xsd:anyURI ;
    prof:hasRole role:specification ;
    sdo:description "The normative, human-readable, listing of profile requirements"@en ;
    sdo:name "Specification Document"@en ;
.

:validator
    dcterms:conformsTo <https://www.w3.org/TR/shacl/> ;
    dcterms:format "text/turtle" ;
    prof:hasArtifact "https://linked.data.gov.au/def/valpub/validator"^^xsd:anyURI ;
    prof:hasRole role:validation ;
    sdo:description "A SHACL Shapes file to be used to test the conformance of RDF data to this profile"@en ;
    sdo:name "Validator in SHACL"@en ;
.

:htv
    dcterms:format "text/html" ;
    prof:hasArtifact "https://linked.data.gov.au/def/valpub/htv"^^xsd:anyURI ;
    prof:hasRole role:guidance ;
    sdo:description "Written instructions on how to use the ValPub profile's validator on data."@en ;
    sdo:name "ValPub's How to Validate"@en ;
.

<https://linked.data.gov.au/org/agldwg>
    a sdo:Organization ;
    sdo:name "Australian Government Linked Data Working Group" ;
    sdo:url "https://www.linked.data.gov.au"^^xsd:anyURI ;
.

